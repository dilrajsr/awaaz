# Google Gemini (required for the assistant). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Azure AI Speech: speech-to-text and text-to-speech for all 10 languages (incl. Punjabi pa-IN).
# Azure portal > Create resource > "Speech" (the free F0 tier is enough to start). Copy KEY 1 and the region, e.g. centralindia.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# SMS bridge that accepts POST {"to": "+91...", "message": "..."} (optional; without it OTP login is dev-only)
SMS_WEBHOOK_URL=
# Set these in production so secrets survive redeploys (otherwise they are generated into the data folder)
AWAAZ_JWT_SECRET=
AWAAZ_FERNET_KEY=
AWAAZ_DATA_DIR=./data
MONITOR_INTERVAL_HOURS=24
# Server
PORT=8000
HOST=127.0.0.1
# Set to the number of reverse proxies in front (e.g. 1) so rate limits see the real client IP
TRUST_PROXY=
